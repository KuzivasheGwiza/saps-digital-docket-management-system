DDMS_CONNECTION_STRING=Server=tcp:your-sql-host,1433;Database=SAPS.DDMS;User ID=ddms_runtime;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=false
DDMS_JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DDMS_JWT_ISSUER=SAPS-DDMS-API
DDMS_JWT_AUDIENCE=SAPS-DDMS-Frontend
